rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // PRIMITIVES & HELPERS
    // ===============================================================
    function isSignedIn() { return request.auth != null; }
    // As per security mandate: all write operations must be performed by verified users
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // Check if the user is the owner of the document based on the userId in the path
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ===============================================================
    // VALIDATION BLUEPRINTS
    // ===============================================================
    function isValidUserProfile(data) {
      return data.keys().hasAll(['displayName', 'email']) &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.email is string && data.email.size() <= 256;
    }

    function isValidStoryState(data) {
      return data.currentNodeId is number &&
             data.history is list && data.history.size() <= 1000 &&
             data.bookmarks is list && data.bookmarks.size() <= 50;
    }

    function isValidProtocol(data) {
      return data.keys().hasAll(['type', 'data', 'date', 'createdAt']) &&
             data.type in ['test', 'audio'] &&
             data.data is map &&
             data.date is string &&
             data.createdAt is string && data.createdAt.size() <= 40;
    }

    // ===============================================================
    // COLLECTION RULES
    // ===============================================================

    // Root user profiles
    match /users/{userId} {
      // Use "read" to cover both get and list
      allow read: if isOwner(userId);
      
      // Writes require the owner to be email-verified
      allow create: if isOwner(userId) && isVerified() && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isVerified() && isValidUserProfile(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);

      // Sub-collection: Story State
      match /story/state {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && isVerified() && isValidStoryState(incoming());
      }

      // Sub-collection: Protocols (Analyses and Audio)
      match /protocols/{protocolId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isVerified() && isValidProtocol(incoming());
        allow delete: if isOwner(userId) && isVerified();
        
        allow update: if false; 
      }
    }

    // ===============================================================
    // GLOBAL SAFETY NET (Placed at the end)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
