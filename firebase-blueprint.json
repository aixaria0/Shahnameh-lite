{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Stores user-specific settings and state",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["displayName", "email"]
    },
    "StoryState": {
      "title": "Story State",
      "description": "Stores the user's progress in the interactive story",
      "type": "object",
      "properties": {
        "currentNodeId": { "type": "number" },
        "history": { "type": "array", "items": { "type": "number" } },
        "bookmarks": { "type": "array", "items": { "type": "number" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Protocol": {
      "title": "Protocol",
      "description": "Stores a character analysis or audio protocol",
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["test", "audio"] },
        "data": { "type": "object" },
        "date": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "data", "date", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user document"
    },
    "/users/{userId}/story/state": {
      "schema": "StoryState",
      "description": "Current story progress"
    },
    "/users/{userId}/protocols/{protocolId}": {
      "schema": "Protocol",
      "description": "Saved protocols and analyses"
    }
  }
}
